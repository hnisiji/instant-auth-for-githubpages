{
  "name": "@instant-lock/cli",
  "version": "1.0.0",
  "description": "CLI tool to encrypt static site resources for Instant Lock",
  "keywords": [
    "cli",
    "encryption",
    "static-site",
    "password-protection"
  ],
  "author": "hnisiji",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hnisiji/instant-lock.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/hnisiji/instant-lock/issues"
  },
  "homepage": "https://github.com/hnisiji/instant-lock#readme",
  "bin": {
    "instant-lock": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:sw": "esbuild src/sw/index.ts --bundle --outfile=dist/assets/sw.js --minify --platform=browser --external:crypto",
    "copy:assets": "mkdir -p dist/assets && cp assets/index.html dist/assets/",
    "build": "npm run copy:assets && tsc -b && npm run build:sw",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^10.0.0",
    "glob": "^10.0.0"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.0.0",
    "esbuild": "^0.27.2",
    "http-server": "^14.1.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.0.0"
  }
}
